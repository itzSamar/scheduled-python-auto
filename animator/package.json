{
  "name": "reddit-story-animator",
  "private": true,
  "version": "1.0.0",
  "description": "Renders animated Reddit story Shorts (2D/3D Three.js) from a screenplay + voice timeline",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render StoryShort",
    "still": "remotion still StoryShort",
    "stills": "node scripts/stills.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.545",
    "@remotion/three": "4.0.545",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.545",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.545",
    "@remotion/renderer": "4.0.545",
    "@types/react": "19.3.0",
    "@types/three": "0.187.0",
    "typescript": "5.9.3"
  }
}
